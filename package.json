{
  "name": "subshelf",
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build --mode production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "npm run typecheck && npm test && npm run build && python3 scripts/package.py",
    "audit:dom": "node scripts/audit-dom.mjs",
    "audit:deps": "npm audit --omit=dev --audit-level=high"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.23",
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.12.7",
    "typescript": "^5.4.5",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
